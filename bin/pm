#!/usr/bin/env bash
set -euo pipefail

usage() {
    cat <<'EOF'
Usage:
  pm add <package>
  pm install [--dry-run] [--bundle <name>] <package> ...
  pm uninstall [--dry-run] [--bundle <name>] <package> ...
  pm stow [--dry-run] [--bundle <name>] <package> ...

Use package names, bundles, or both. Conflicting regular files are saved as backups.
EOF
}

die() {
    printf 'pm: %s\n' "$*" >&2
    exit 1
}

valid_name() {
    [[ $1 =~ ^[a-zA-Z0-9][a-zA-Z0-9._+-]*$ ]]
}

request_package() {
    local name=$1
    valid_name "$name" || die "invalid package name: $name"
    if [[ ! ${requested[$name]+set} ]]; then
        packages+=("$name")
        requested[$name]=1
    fi
}

read_bundle() {
    local name=$1 line
    [[ ! ${active_bundles[$name]+set} ]] || die "bundle include cycle: $name"
    valid_name "$name" || die "invalid bundle name: $name"
    local path="$repo/bundles/$name"
    [[ -f $path ]] || die "unknown bundle: $name"
    active_bundles[$name]=1
    while IFS= read -r line || [[ -n $line ]]; do
        [[ $line =~ ^[[:space:]]*(#|$) ]] && continue
        if [[ $line == @* ]]; then
            read_bundle "${line#@}"
        else
            request_package "$line"
        fi
    done < "$path"
    unset 'active_bundles[$name]'
}

read_package() {
    local line row_distro installer target row_architecture
    local row_pattern=$'^([a-z][a-z0-9-]*)\t([a-z][a-z0-9-]*)\t([^\t]+)(\t([a-z0-9_]+(,[a-z0-9_]+)*))?$'
    local has_rows=0 has_distro_rows=0 supported_architectures= architecture_matched=0
    local -a installers=() targets=()

    while IFS= read -r line || [[ -n $line ]]; do
        [[ $line =~ ^[[:space:]]*(#|$) ]] && continue
        [[ $line =~ $row_pattern ]] || die "$package: expected three tab-separated fields and an optional architecture"
        row_distro=${BASH_REMATCH[1]}
        installer=${BASH_REMATCH[2]}
        target=${BASH_REMATCH[3]}
        row_architecture=${BASH_REMATCH[5]}
        has_rows=1
        [[ $row_distro == "$distro" ]] || continue
        has_distro_rows=1
        case $distro:$installer in
            debian:apt|arch:pacman|*:flatpak)
                [[ $target =~ ^[a-zA-Z0-9][a-zA-Z0-9.+_:@-]*$ ]] \
                    || die "$package: invalid $installer target: $target"
                ;;
            *:script)
                [[ $target =~ ^[a-zA-Z0-9][a-zA-Z0-9._+-]*\.sh$ && -f $package_dir/$target ]] \
                    || die "$package: script row must point to a package-local .sh file"
                ;;
            *) die "$package: unsupported installer for $distro: $installer" ;;
        esac
        if [[ -n $row_architecture ]]; then
            if [[ ,$supported_architectures, != *,"$row_architecture",* ]]; then
                supported_architectures+=${supported_architectures:+,}$row_architecture
            fi
            [[ ,$row_architecture, == *,"$architecture",* ]] || continue
            architecture_matched=1
        fi
        installers+=("$installer")
        targets+=("$target")
    done < "$package_dir/install.tsv"

    if (( has_rows && ! has_distro_rows )); then
        skipped[$package]="no install mapping for $distro"
    elif [[ -n $supported_architectures ]] && (( ! architecture_matched )); then
        skipped[$package]="installer supports $supported_architectures (detected $architecture)"
    fi
    if (( has_rows == 0 )) && [[ ! -d $package_dir/stow ]]; then
        die "$package: add an install mapping or a stow/ directory"
    fi
    plan_start[$package]=${#plan_installers[@]}
    plan_count[$package]=${#installers[@]}
    plan_installers+=("${installers[@]}")
    plan_targets+=("${targets[@]}")
}

run() {
    printf '  +'
    printf ' %q' "$@"
    printf '\n'
    if (( ! dry_run )); then
        "$@"
    fi
}

native_install() {
    local target=$1
    case $distro in
        debian)
            apt_architecture=${apt_architecture:-$(dpkg --print-architecture)}
            if dpkg-query -W -f='${Architecture} ${db:Status-Status}\n' -- "$target" 2>/dev/null |
                awk -v arch="$apt_architecture" -v target="$target" '
                    $2 == "installed" && (target ~ /:/ || $1 == arch || $1 == "all") { found = 1 }
                    END { exit !found }
                '; then
                printf '  Already installed: %s\n' "$target"
                return
            fi
            if (( ! apt_updated )); then
                run sudo apt-get update
                apt_updated=1
            fi
            run sudo apt-get install -y -- "$target"
            ;;
        arch)
            if pacman -Q -- "$target" >/dev/null 2>&1; then
                printf '  Already installed: %s\n' "$target"
                return
            fi
            run sudo pacman -S --needed --noconfirm -- "$target"
            ;;
    esac
}

install_target() {
    local installer=$1 target=$2
    case $installer in
        apt|pacman) native_install "$target" ;;
        flatpak)
            if ! command -v flatpak >/dev/null; then
                native_install flatpak
            elif flatpak info --system "$target" >/dev/null 2>&1; then
                printf '  Already installed from Flatpak: %s\n' "$target"
                return
            fi
            run sudo flatpak remote-add --system --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
            run sudo flatpak install --system --noninteractive flathub "$target"
            ;;
        script) run bash "$package_dir/$target" ;;
    esac
}

uninstall_target() {
    local installer=$1 target=$2
    case $installer in
        apt)
            if [[ $(dpkg-query -W -f='${db:Status-Status}' -- "$target" 2>/dev/null) != installed ]]; then
                printf '  Not installed: %s\n' "$target"
                return
            fi
            run sudo apt-get remove -y -- "$target"
            ;;
        pacman)
            if ! pacman -Q -- "$target" >/dev/null 2>&1 && ! pacman -Qg -- "$target" >/dev/null 2>&1; then
                printf '  Not installed: %s\n' "$target"
                return
            fi
            run sudo pacman -R --noconfirm -- "$target"
            ;;
        flatpak)
            if ! command -v flatpak >/dev/null || ! flatpak info --system "$target" >/dev/null 2>&1; then
                printf '  Not installed from Flatpak: %s\n' "$target"
                return
            fi
            run sudo flatpak uninstall --system --noninteractive "$target"
            ;;
        script)
            if [[ -f $package_dir/uninstall.sh ]]; then
                run bash "$package_dir/uninstall.sh"
            else
                printf 'pm: Warning: %s: missing uninstall.sh; skipping script removal.\n' "$package" >&2
            fi
            ;;
    esac
}

stow_command() (
    # Use package-local ignore rules and keep .stowrc from changing backup policy.
    cd /
    HOME=/dev/null LC_ALL=C stow --dir="$package_dir" --target="$target_home" \
        --no-folding "$@" stow
)

unstow_package() {
    [[ -d $package_dir/stow ]] || return 0
    local target_home
    target_home=$(realpath -- "$HOME")
    if (( dry_run )); then
        stow_command --delete --simulate --verbose=1
    else
        stow_command --delete --verbose=1
    fi
}

# Helpers use the transaction variables local to stow_package.
collect_stow_conflicts() {
    # Back up only regular files that Stow itself reported as conflicts.
    local prefix suffix path_pattern
    prefix="  * cannot stow $(realpath --relative-to="$target_home" -- "$package_dir")/stow/"
    suffix=' since neither a link nor a directory and --adopt not specified'
    path_pattern='^(.+) over existing target \1$'
    while IFS= read -r line; do
        [[ $line == '  * '* ]] || continue
        if [[ $line == "$prefix"*"$suffix" ]]; then
            relative=${line#"$prefix"}
            relative=${relative%"$suffix"}
            if [[ $relative =~ $path_pattern ]]; then
                relative=${BASH_REMATCH[1]}
                target="$target_home/$relative"
                if [[ -f $target && ! -L $target ]]; then
                    conflicts+=("$relative")
                    continue
                fi
            fi
        fi
        printf '%s\n' "$output" >&2
        return 1
    done <<< "$output"
    if (( ${#conflicts[@]} == 0 )); then
        printf '%s\n' "$output" >&2
        return 1
    fi
}

plan_stow_backups() {
    for relative in "${conflicts[@]}"; do
        backup="$relative.bak"
        number=0
        while [[ -e $target_home/$backup || -L $target_home/$backup \
            || -e $package_dir/stow/$backup || -L $package_dir/stow/$backup ]]; do
            backup="$relative.bak.$(( ++number ))"
        done
        backups+=("$target_home/$backup")
        if [[ $action == preview ]]; then
            printf '  Would back up %s to %s\n' "$target_home/$relative" "$target_home/$backup"
            printf '  Would link %s to %s\n' "$target_home/$relative" "$package_dir/stow/$relative"
        fi
    done
}

restore_stow_backups() {
    # Restore backups where the original path is still vacant after a failure.
    while (( moved > 0 )); do
        moved=$(( moved - 1 ))
        target="$target_home/${conflicts[moved]}"
        backup=${backups[moved]}
        if mv -nT -- "$backup" "$target" && [[ ! -e $backup && ! -L $backup ]]; then
            printf 'pm: Restored %s from its backup\n' "$target" >&2
        else
            printf 'pm: Original %s is saved at %s\n' "$target" "$backup" >&2
        fi
    done
}

stow_package() {
    local action=$1 output line relative target backup number index moved=0
    local -a conflicts=() backups=()
    [[ -d $package_dir/stow ]] || return 0
    command -v stow >/dev/null || die 'GNU Stow is required for packages with a stow/ directory'
    local target_home
    target_home=$(realpath -- "$HOME")

    if output=$(stow_command --simulate --verbose=1 2>&1); then
        case $action in
            preview) printf '%s\n' "$output" ;;
            apply) stow_command ;;
        esac
        return
    fi

    collect_stow_conflicts || return 1
    [[ $action == check ]] && return 0

    plan_stow_backups
    if [[ $action == preview ]]; then
        sed -n '/^LINK: /p; /^MKDIR: /p' <<< "$output"
        return 0
    fi

    for index in "${!conflicts[@]}"; do
        target="$target_home/${conflicts[index]}"
        backup=${backups[index]}
        if [[ ! -f $target || -L $target ]] || ! mv -nT -- "$target" "$backup" \
            || [[ -e $target || -L $target ]]; then
            printf 'pm: Could not back up %s to %s\n' "$target" "$backup" >&2
            break
        fi
        moved=$(( moved + 1 ))
        printf '  Backup created: %s\n' "$backup"
    done
    if (( moved == ${#conflicts[@]} )) && stow_command; then
        return 0
    fi

    restore_stow_backups
    return 1
}

check_stow_packages() {
    local package package_dir
    for package in "${packages[@]}"; do
        [[ ! ${skipped[$package]+set} ]] || continue
        package_dir="$repo/packages/$package"
        stow_package check
    done
}

case ${1:-} in
    -h|--help|help) usage; exit 0 ;;
    add|install|uninstall|stow) subcommand=$1; shift ;;
    *) usage >&2; exit 1 ;;
esac

script_path=$(realpath -- "${BASH_SOURCE[0]}")
repo=$(cd -- "$(dirname -- "$script_path")/.." && pwd -P)

if [[ $subcommand == add ]]; then
    (( $# == 1 )) && valid_name "$1" || die 'usage: pm add <package>'
    package_dir="$repo/packages/$1"
    mkdir -- "$package_dir" || die "could not create package: $1"
    printf '# distro\tinstaller\ttarget\n' > "$package_dir/install.tsv"
    printf 'Created %s\n' "$package_dir/install.tsv"
    exit 0
fi

(( EUID != 0 )) || die 'run pm as your regular user'
[[ -r /etc/os-release ]] || die 'cannot read /etc/os-release'
distro=$(. /etc/os-release; printf '%s' "${ID:-}")
architecture=$(uname -m)
case $distro in
    debian|arch) ;;
    *) die "unsupported distro: $distro" ;;
esac

declare -A requested=() skipped=() active_bundles=() plan_start=() plan_count=()
declare -a packages=() plan_installers=() plan_targets=()
dry_run=0
apt_updated=0

while (( $# )); do
    case $1 in
        --dry-run) dry_run=1 ;;
        --backup) ;; # Backups are now the default.
        --bundle)
            (( $# >= 2 )) || die '--bundle requires a name'
            read_bundle "$2"
            shift
            ;;
        -*) die "unknown option: $1" ;;
        *) request_package "$1" ;;
    esac
    shift
done

(( ${#packages[@]} > 0 )) || die 'specify a package or bundle'
printf 'Distro: %s\n' "$distro"

# Serialize applies targeting the same home, without writing a lock file there.
if (( ! dry_run )); then
    exec {home_lock}<"$HOME"
    flock -x "$home_lock"
fi

stow_available=0
if command -v stow >/dev/null; then
    stow_available=1
fi
stow_scheduled=$stow_available

for package in "${packages[@]}"; do
    package_dir="$repo/packages/$package"
    [[ -f $package_dir/install.tsv ]] || die "unknown package: $package"
    if [[ $subcommand == install || $subcommand == uninstall ]]; then
        read_package
        if [[ $subcommand == install && ! ${skipped[$package]+set} && -f $package_dir/hardware-model ]]; then
            read -r required_model < "$package_dir/hardware-model"
            model=
            if [[ -r /sys/devices/virtual/dmi/id/product_name ]]; then
                read -r model < /sys/devices/virtual/dmi/id/product_name
            fi
            if [[ $model != "$required_model" ]]; then
                skipped[$package]="requires hardware model $required_model (detected ${model:-unknown})"
            fi
        fi
    fi
    [[ ! ${skipped[$package]+set} ]] || continue
    if [[ -d $package_dir/stow ]] && (( ! stow_scheduled )); then
        [[ $subcommand != uninstall ]] || die "$package: GNU Stow is required to remove config links"
        die "$package: GNU Stow is required. Install stow or put the stow package first."
    fi
    if [[ $subcommand == install && $package == stow ]]; then
        stow_scheduled=1
    fi
done

if [[ $subcommand == uninstall ]]; then
    # Unlink everything while GNU Stow is still installed, even if it is selected.
    for package in "${packages[@]}"; do
        [[ ! ${skipped[$package]+set} ]] || continue
        package_dir="$repo/packages/$package"
        unstow_package
    done
    # Undo scripts before removing the tools they depend on.
    for (( package_index=${#packages[@]}-1; package_index >= 0; package_index-- )); do
        package=${packages[package_index]}
        [[ ! ${skipped[$package]+set} ]] || continue
        package_dir="$repo/packages/$package"
        printf '%s\n' "$package"
        # One package uninstaller handles all of its script rows, before dependencies.
        for (( index=plan_start[$package]; index < plan_start[$package]+plan_count[$package]; index++ )); do
            if [[ ${plan_installers[index]} == script ]]; then
                uninstall_target script "${plan_targets[index]}"
                break
            fi
        done
        for (( index=plan_start[$package]+plan_count[$package]-1; index >= plan_start[$package]; index-- )); do
            [[ ${plan_installers[index]} != script ]] || continue
            uninstall_target "${plan_installers[index]}" "${plan_targets[index]}"
        done
    done
else
    if (( ! dry_run && stow_available )); then
        check_stow_packages
    fi

    for package in "${packages[@]}"; do
        [[ ! ${skipped[$package]+set} ]] || continue
        package_dir="$repo/packages/$package"
        printf '%s\n' "$package"
        if [[ $subcommand == install ]]; then
            for (( index=plan_start[$package]; index < plan_start[$package]+plan_count[$package]; index++ )); do
                install_target "${plan_installers[index]}" "${plan_targets[index]}"
            done
            if (( ! dry_run && ! stow_available )) && [[ $package == stow ]]; then
                command -v stow >/dev/null || die 'the stow package did not make GNU Stow available on PATH'
                stow_available=1
                check_stow_packages
            fi
        fi

        if (( dry_run )); then
            if (( stow_available )); then
                stow_package preview
            elif [[ -d $package_dir/stow ]]; then
                printf '  Would link files from %s after installing GNU Stow\n' "$package_dir/stow"
            fi
        else
            stow_package apply
        fi
        if [[ $subcommand == install && -f $package_dir/post-install.sh ]]; then
            printf '  Manual follow-up: bash %q\n' "$package_dir/post-install.sh"
        fi
    done
fi

if (( ${#skipped[@]} )); then
    if (( dry_run )); then
        printf '\nPackages that would be skipped\n'
    else
        printf '\nSkipped packages\n'
    fi
    for package in "${packages[@]}"; do
        if [[ ${skipped[$package]+set} ]]; then
            printf '  %s (%s)\n' "$package" "${skipped[$package]}"
        fi
    done
fi
