syntax on
filetype plugin indent on
set mouse=a
set ts=4 sts=4 sw=4 noet aw acd incsearch nohls scs
set nobk noswf noudf
let mapleader = " "
nnoremap H :bp<cr>
nnoremap L :bn<cr>
nnoremap <leader>w :w<cr>
nnoremap <leader>q :q<cr>
nnoremap <leader>x :wqa<cr>
nnoremap <leader>so :so ~/.vimrc<cr>
set cursorline
colorscheme slate
